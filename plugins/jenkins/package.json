  },
  "keywords": ["ilmari", "plugin", "jenkins", "ci"],
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ilmari-plugin-kit": "file:../../../ilmari/packages/plugin-kit",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
